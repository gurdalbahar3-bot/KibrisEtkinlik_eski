# Supabase — public discovery READ (server-side, anon key + RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Data source: supabase (default) | mock (development only, must be EXPLICIT)
# mock     — local/UI lab in-memory events. FORBIDDEN in staging/production.
# supabase — staging/production Supabase READ via RLS
# Unset / missing credentials never fall back to mock.
# SUPABASE_DATA_SOURCE=mock

# Service role — NOT used for public discovery; admin/backend only
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth: omit in local development (dev cookie). Staging/production use Supabase.
# Set to supabase to test real auth locally.
# ADMIN_AUTH=supabase

# Site URL (SEO / JSON-LD)
NEXT_PUBLIC_SITE_URL=https://globaleventdiscovery.com
