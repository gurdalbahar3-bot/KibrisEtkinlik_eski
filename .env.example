# Supabase — public discovery READ (server-side, anon key + RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Data source: mock (default) | supabase
# mock     — existing in-memory mock events (no DB required)
# supabase — staging/production Supabase READ via RLS
SUPABASE_DATA_SOURCE=mock

# Service role — NOT used for public discovery; admin/backend only
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth: omit in development (dev cookie). Set to supabase to test real auth locally.
# ADMIN_AUTH=supabase

# Site URL (SEO / JSON-LD)
NEXT_PUBLIC_SITE_URL=https://kibrisetkinlik.com

# Google Maps (browser) — venue create/edit map picker (Maps JavaScript API + Geocoding API)
# Set in Vercel Preview/Production; never commit a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Örümcek live crawl (default OFF). Never auto-publishes; never writes public events.
# Restart `next dev` after changing these. Super Admin still remains the only publish gate.
# ORUMCEK_LIVE_CRAWL=1
# ORUMCEK_CRAWL_SOURCE=kibris-biletcim
# Optional cap (max 5): ORUMCEK_CRAWL_MAX_EVENTS=3
