# Supabase — public discovery READ (server-side, anon key + RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Data source: mock | supabase
# Development / test:
#   unset or mock  → in-memory mock catalog (local UI lab)
#   supabase       → requires SUPABASE_URL + SUPABASE_ANON_KEY
# Production:
#   MUST be supabase with SUPABASE_URL + SUPABASE_ANON_KEY
#   unset, mock, or any other value fail loud — never a silent mock fallback
# Do not set mock for production deploys.
# SUPABASE_DATA_SOURCE=supabase

# Service role — NOT used for public discovery; admin/backend only
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth: omit in development (dev cookie). Set to supabase to test real auth locally.
# ADMIN_AUTH=supabase

# Site URL (SEO / JSON-LD)
NEXT_PUBLIC_SITE_URL=https://globaleventdiscovery.com

# Optional live Super Admin JWT E2E (scripts/assert-live-jwt-publish-e2e.mjs)
# SA_E2E_EMAIL=
# SA_E2E_PASSWORD=
# REQUIRE_LIVE_JWT_E2E=0

# Playwright Sprint 1 (e2e/sprint1-sa-publish.spec.ts) — names only, never commit values
# Required to run (otherwise skip unless REQUIRE_LIVE_JWT_E2E=1):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_DATA_SOURCE
#   SA_E2E_EMAIL
#   SA_E2E_PASSWORD
# Preferred fixture (approved|unpublished event):
#   SA_E2E_EVENT_ID
# Optional:
#   PLAYWRIGHT_BASE_URL
#   REQUIRE_LIVE_JWT_E2E
#   ADMIN_AUTH

# Staging logical backup (scripts/staging-backup-preflight.mjs) — names only
# Set these locally / in the terminal. Never paste values into chat or commit them.
#   STAGING_PROJECT_REF
#   STAGING_DB_URL
#   STAGING_CONFIRM=KibrisEtkinlik-Staging

# iyzico (Phase B) — SANDBOX only. Never commit values. Never use NEXT_PUBLIC_*.
# B1 does not call the API; keys are for B2+.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Do NOT set IYZICO_BASE_URL to https://api.iyzipay.com during Phase B.
